#!/bin/sh
set -eu

workspace=${BOOTHSTRAP_WORKSPACE:-$PWD}
if [ ! -e "$workspace" ]; then
  exit 0
fi
if [ ! -d "$workspace" ] || [ ! -w "$workspace" ]; then
  echo "local-vibe-coding cleanup: workspace is not writable: $workspace" >&2
  exit 1
fi

rm -f -- "$workspace/.local-vibe-state" "$workspace/.local-vibe-url"
