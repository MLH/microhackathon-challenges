#!/usr/bin/env bash
# Standalone Pi session. Leave the app and conversation behind for inspection.
set -euo pipefail

package_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
command -v node >/dev/null 2>&1 || { echo 'local-vibe-coding: node is required' >&2; exit 1; }
command -v pi >/dev/null 2>&1 || { echo 'local-vibe-coding: pi is required' >&2; exit 1; }
node -e 'import(process.argv[1]).catch(() => { console.error("local-vibe-coding: Pi form dependency missing; run ./local-vibe-coding/install first"); process.exitCode = 1; })' "$package_dir/mad-libs.mjs"

scratch_base="${TMPDIR:-/tmp}"
[ -d "$scratch_base" ] || { echo "local-vibe-coding: temporary directory missing: $scratch_base" >&2; exit 1; }
root="$(mktemp -d "$scratch_base/local-vibe.XXXXXXXX")"
workspace="$root/workspace"
mkdir -p "$workspace" "$root/pi-sessions"
echo "Workspace: $workspace"
echo "Pi history: $root/pi-sessions"

preview_token=''
preview_port=4321
if [ "${NODE_ENV:-}" = test ] && [ -n "${LOCAL_VIBE_TEST_PORT:-}" ]; then
  preview_port=$LOCAL_VIBE_TEST_PORT
fi
finish() {
  status=$?
  trap - EXIT
  if [ -n "$preview_token" ]; then
    node "$package_dir/control.mjs" stop "http://127.0.0.1:$preview_port" "$preview_token" 2>/dev/null || true
  fi
  BOOTHSTRAP_WORKSPACE="$workspace" "$package_dir/cleanup" ||
    echo "local-vibe-coding: cleanup failed in $workspace" >&2
  echo "Saved workspace and Pi history in $root"
  exit "$status"
}
trap finish EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

BOOTHSTRAP_WORKSPACE="$workspace" "$package_dir/setup"
preview_token=$(node "$package_dir/control.mjs" read-state "$workspace/.local-vibe-state")

model="$(node -e 'console.log(JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8")).model)' "$package_dir/challenge.json")"
echo "Preview: http://127.0.0.1:$preview_port/"
echo 'Open this URL in your browser and follow Pi’s prompt.'
cd "$workspace"
pi --model "$model" \
  --skill "$package_dir/skills/start-challenge/SKILL.md" \
  --extension "$package_dir/mad-libs.mjs" \
  --session-dir "$root/pi-sessions" \
  '/skill:start-challenge'
