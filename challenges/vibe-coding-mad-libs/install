#!/bin/sh
# Installs the Pi packages the Mad Libs form extension imports, at the
# versions boothstrap's Pi uses, into this package's node_modules.
set -eu

# pwd -P resolves symlinks: npm ci fails on a --prefix that isn't a real path.
package_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
npm ci --ignore-scripts --no-audit --no-fund --prefix "$package_dir"
