{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "extraKnownMarketplaces": {
    "mechaswift": {
      "source": {
        "source": "github",
        "repo": "theycallmeswift/skills"
      }
    }
  },
  "enabledPlugins": {
    "core@mechaswift": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/claude-cloud-node26-path.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm test)",
      "Bash(npm run verify)",
      "Bash(npm run lint)",
      "Bash(node --test:*)",
      "Bash(node tools/verify.mjs:*)",
      "Bash(npx boothstrap dev --verify:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --force-with-lease origin main:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin +:*)",
      "Bash(git merge --ff-only:*)"
    ]
  }
}
